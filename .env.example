# ==============================================================================
# Antigravity Liquid Token Lens — Variables de Entorno de Ejemplo
# ==============================================================================

# Puerto para el servidor backend (HTTP y WebSocket)
PORT=3001

# Host de enlace (127.0.0.1 para desarrollo local seguro)
BIND_HOST=127.0.0.1

# Directorio raíz donde Antigravity almacena las transcripciones
# Por defecto se autodetecta en ~/.gemini/antigravity-ide/brain/
ANTIGRAVITY_LOGS_ROOT=

# Token de autorización para conexiones LAN (Obligatorio si BIND_HOST no es 127.0.0.1)
TOKEN_LENS_API_TOKEN=

# API Key opcional de Google AI Studio / Gemini para cuotas de cuenta
GEMINI_API_KEY=

# URL del backend para la aplicación web
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
