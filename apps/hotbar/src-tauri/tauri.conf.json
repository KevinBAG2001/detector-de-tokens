{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Hotbar",
  "version": "0.1.0",
  "identifier": "com.antigravity.hotbar",
  "build": {
    "beforeDevCommand": "pnpm --filter @antigravity/local-ingest... build && pnpm dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @antigravity/local-ingest build && pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Hotbar",
        "width": 360,
        "height": 340,
        "minWidth": 320,
        "minHeight": 280,
        "maxWidth": 480,
        "maxHeight": 520,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
