{
  "name": "@antigravity/local-ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Ingesta local de telemetría Antigravity (logs JSONL) — Zero-Leakage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli/snapshot": {
      "import": "./dist/cli/snapshot.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "echo \"Linting local-ingest...\"",
    "test": "vitest run",
    "snapshot": "node dist/cli/snapshot.js"
  },
  "dependencies": {
    "@antigravity/domain-core": "workspace:*",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
